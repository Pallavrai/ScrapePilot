# Copy to .env and keep it private. Load it into each shell before pnpm commands:
#   set -a; . ./.env; set +a
# "local:" / "Docker:" notes mark values that differ between pnpm dev/worker and Docker Compose.

# URL-safe passwords: openssl rand -hex 24. Docker: Compose builds DATABASE_URL from POSTGRES_PASSWORD.
DATABASE_URL=postgres://scrapepilot:replace-this-password@localhost:5432/scrapepilot
POSTGRES_PASSWORD=replace-this-password
# Docker: keep 6379; Compose overrides REDIS_HOST but not the port.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-this-redis-password

# Generate each independently: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=

# Required for signup verification and password reset. Keep the quotes.
# Without a verified domain, "ScrapePilot <onboarding@resend.dev>" delivers only to your Resend account email.
RESEND_API_KEY=
EMAIL_FROM="ScrapePilot <verify@your-domain.com>"

# Docker: wss://your-domain/browser, BETTER_AUTH_URL=https://your-domain, APP_DOMAIN=your-domain.
WORKER_PUBLIC_URL=ws://localhost:3001/browser
APP_DOMAIN=localhost

# local: an absolute path such as /path/to/ScrapePilot/artifacts. Docker: /data/artifacts.
ARTIFACT_DIR=/data/artifacts
# Production browsers must use the restricted egress proxy. local: leave empty.
BROWSER_PROXY=http://egress:3002
